<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="DevWorks Test" Language="1033" Version="0.1.0"
           Manufacturer="SceneWorks" UpgradeCode="BC9A5811-2AB9-4479-9419-7D6C2D85DD26">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser" InstallPrivileges="limited" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <MajorUpgrade AllowSameVersionUpgrades="yes" Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of DevWorks Test is already installed." />
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="INSTALLFOLDER" Name="DevWorks Test">
          <Component Id="TestPayload" Guid="31279012-9178-4474-830A-523C5F1D08DA" Win64="yes">
            <File Id="DesktopExe" Source="$(var.Payload)\devworks-desktop.exe" />
            <File Id="PdfWorkerExe" Source="$(var.Payload)\devworks-pdf-worker.exe" />
            <File Id="PdfNotices" Source="$(var.Payload)\pdf-notices.zip" />
            <RegistryValue Root="HKCU" Key="Software\SceneWorks\DevWorks Test" Name="Installed"
                           Type="integer" Value="1" KeyPath="yes" />
            <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Component Id="TestShortcut" Guid="618198A9-DB55-450F-974F-4F37726E142A" Win64="yes">
          <Shortcut Id="StartMenu" Name="DevWorks Test" Target="[INSTALLFOLDER]devworks-desktop.exe"
                    WorkingDirectory="INSTALLFOLDER" Arguments="--data-dir &quot;[LocalAppDataFolder]DevWorks Test Data&quot;" />
          <RegistryValue Root="HKCU" Key="Software\SceneWorks\DevWorks Test" Name="Shortcut"
                         Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </Directory>
    <Feature Id="DevWorksTest" Title="DevWorks Test" Level="1">
      <ComponentRef Id="TestPayload" />
      <ComponentRef Id="TestShortcut" />
    </Feature>
  </Product>
</Wix>
