{
  "$comment": "Architecture candidate only. Schema validation is followed by typed range, cross-field and authority validation. Not a public v1 SDK.",
  "$defs": {
    "AddonCommand": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "bundle": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "expectedRegistryRevision": {
              "$ref": "#/$defs/Revision"
            },
            "kind": {
              "const": "Install",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "bundle",
            "expectedRegistryRevision"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "bundle": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "expectedRegistryRevision": {
              "$ref": "#/$defs/Revision"
            },
            "kind": {
              "const": "Update",
              "type": "string"
            },
            "packageId": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": [
            "kind",
            "packageId",
            "bundle",
            "expectedRegistryRevision"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "expectedRegistryRevision": {
              "$ref": "#/$defs/Revision"
            },
            "kind": {
              "const": "Enable",
              "type": "string"
            },
            "packageId": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": [
            "kind",
            "packageId",
            "expectedRegistryRevision"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "expectedRegistryRevision": {
              "$ref": "#/$defs/Revision"
            },
            "kind": {
              "const": "Disable",
              "type": "string"
            },
            "packageId": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": [
            "kind",
            "packageId",
            "expectedRegistryRevision"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "expectedRegistryRevision": {
              "$ref": "#/$defs/Revision"
            },
            "expectedStateGeneration": {
              "$ref": "#/$defs/Revision"
            },
            "kind": {
              "const": "Rollback",
              "type": "string"
            },
            "packageId": {
              "$ref": "#/$defs/Id"
            },
            "targetManifestDigest": {
              "$ref": "#/$defs/Digest"
            }
          },
          "required": [
            "kind",
            "packageId",
            "targetManifestDigest",
            "expectedRegistryRevision",
            "expectedStateGeneration"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "expectedRegistryRevision": {
              "$ref": "#/$defs/Revision"
            },
            "kind": {
              "const": "Uninstall",
              "type": "string"
            },
            "packageId": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": [
            "kind",
            "packageId",
            "expectedRegistryRevision"
          ],
          "type": "object"
        }
      ]
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/Id"
        },
        "byteLength": {
          "$ref": "#/$defs/Counter"
        },
        "mediaType": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Digest"
        },
        "versionId": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "artifactId",
        "versionId",
        "sha256",
        "byteLength",
        "mediaType"
      ],
      "type": "object"
    },
    "Counter": {
      "description": "Canonical decimal 0..9223372036854775807. Typed range validation required.",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "type": "string"
    },
    "Digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "Id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "Protocol": {
      "enum": [
        "1.0-draft.1"
      ],
      "type": "string"
    },
    "Revision": {
      "description": "Positive signed-64-bit counter; typed upper-bound validation required.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    }
  },
  "$id": "urn:devworks:architecture:1.0-draft.1:addon-command-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "command": {
      "$ref": "#/$defs/AddonCommand"
    },
    "protocol": {
      "$ref": "#/$defs/Protocol"
    },
    "requestKey": {
      "$ref": "#/$defs/Id"
    },
    "schemaRevision": {
      "description": "Negotiated operation schema revision. Absent means 1. Only revisions the selected operation registers are admitted; any other is UnsupportedSchema before authority.",
      "maximum": 65535,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "protocol",
    "requestKey",
    "command"
  ],
  "title": "AddonCommandRequest",
  "type": "object"
}
