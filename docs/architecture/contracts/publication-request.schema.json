{
  "$comment": "Architecture candidate only. Schema validation is followed by typed range, cross-field and authority validation. Not a public v1 SDK.",
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/Id"
        },
        "byteLength": {
          "$ref": "#/$defs/Counter"
        },
        "mediaType": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Digest"
        },
        "versionId": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "artifactId",
        "versionId",
        "sha256",
        "byteLength",
        "mediaType"
      ],
      "type": "object"
    },
    "Counter": {
      "description": "Canonical decimal 0..9223372036854775807. Typed range validation required.",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "type": "string"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "gaps": {
          "items": {
            "$ref": "#/$defs/Id"
          },
          "maxItems": 128,
          "type": "array"
        },
        "moreGaps": {
          "type": "boolean"
        },
        "state": {
          "$ref": "#/$defs/CoverageState"
        }
      },
      "required": [
        "state",
        "gaps",
        "moreGaps"
      ],
      "type": "object"
    },
    "CoverageState": {
      "enum": [
        "Complete",
        "Partial",
        "Unavailable"
      ],
      "type": "string"
    },
    "Digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "GitOid": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "$ref": "#/$defs/ObjectFormat"
        },
        "hex": {
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$",
          "type": "string"
        }
      },
      "required": [
        "format",
        "hex"
      ],
      "type": "object"
    },
    "Id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "LayerRef": {
      "additionalProperties": false,
      "properties": {
        "generationId": {
          "$ref": "#/$defs/Id"
        },
        "manifestDigest": {
          "$ref": "#/$defs/Digest"
        },
        "parentGenerationId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "generationId",
        "manifestDigest"
      ],
      "type": "object"
    },
    "ObjectFormat": {
      "enum": [
        "Sha1",
        "Sha256"
      ],
      "type": "string"
    },
    "Protocol": {
      "enum": [
        "1.0-draft.1"
      ],
      "type": "string"
    },
    "RepositorySnapshot": {
      "additionalProperties": false,
      "properties": {
        "base": {
          "$ref": "#/$defs/GitOid"
        },
        "captureDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "head": {
          "$ref": "#/$defs/GitOid"
        },
        "repositoryId": {
          "$ref": "#/$defs/Id"
        },
        "worktreeId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "repositoryId",
        "base",
        "head"
      ],
      "type": "object"
    },
    "RepositoryView": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "$ref": "#/$defs/LayerRef"
        },
        "branch": {
          "anyOf": [
            {
              "$ref": "#/$defs/LayerRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "snapshot": {
          "$ref": "#/$defs/RepositorySnapshot"
        },
        "sourceRevision": {
          "$ref": "#/$defs/Revision"
        },
        "viewId": {
          "$ref": "#/$defs/Id"
        },
        "worktree": {
          "anyOf": [
            {
              "$ref": "#/$defs/LayerRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "viewId",
        "snapshot",
        "sourceRevision",
        "baseline",
        "coverage"
      ],
      "type": "object"
    },
    "Revision": {
      "description": "Positive signed-64-bit counter; typed upper-bound validation required.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    }
  },
  "$id": "urn:devworks:architecture:1.0-draft.1:publication-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "expectedPointerRevision": {
      "$ref": "#/$defs/Counter"
    },
    "expectedSourceRevision": {
      "$ref": "#/$defs/Revision"
    },
    "operationId": {
      "$ref": "#/$defs/Id"
    },
    "protocol": {
      "$ref": "#/$defs/Protocol"
    },
    "sealedManifest": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "sourceId": {
      "$ref": "#/$defs/Id"
    },
    "view": {
      "$ref": "#/$defs/RepositoryView"
    }
  },
  "required": [
    "protocol",
    "operationId",
    "sourceId",
    "expectedSourceRevision",
    "expectedPointerRevision",
    "view",
    "sealedManifest"
  ],
  "title": "PublicationRequest",
  "type": "object"
}
