{
  "$comment": "Architecture candidate only. Schema validation is followed by typed range, cross-field and authority validation. Not a public v1 SDK.",
  "$defs": {
    "AccessMode": {
      "enum": [
        "ApiKey",
        "Subscription",
        "Local",
        "Custom"
      ],
      "type": "string"
    },
    "Counter": {
      "description": "Canonical decimal 0..9223372036854775807. Typed range validation required.",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "type": "string"
    },
    "EndpointProfile": {
      "enum": [
        "OpenAiResponses",
        "CodexSubscriptionResponses",
        "AnthropicMessages",
        "ClaudeSubscriptionMessages",
        "OpenRouterChat",
        "CompatibleChat",
        "Embedding"
      ],
      "type": "string"
    },
    "Id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "NativeBinding": {
      "additionalProperties": false,
      "properties": {
        "accountRevision": {
          "$ref": "#/$defs/Revision"
        },
        "connectionId": {
          "$ref": "#/$defs/Id"
        },
        "contextEpoch": {
          "$ref": "#/$defs/Counter"
        },
        "endpointProfile": {
          "$ref": "#/$defs/EndpointProfile"
        },
        "modelId": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "connectionId",
        "accountRevision",
        "endpointProfile",
        "modelId",
        "contextEpoch"
      ],
      "type": "object"
    },
    "PriceBasis": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "ReportedPreferred",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "RateSnapshot",
              "type": "string"
            },
            "overrideRevision": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Revision"
                },
                {
                  "type": "null"
                }
              ]
            },
            "snapshotId": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": [
            "kind",
            "snapshotId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "LocalFree",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "Untracked",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "Revision": {
      "description": "Positive signed-64-bit counter; typed upper-bound validation required.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "SelectionReason": {
      "enum": [
        "Explicit",
        "SessionPin",
        "RoundRobin",
        "Failover"
      ],
      "type": "string"
    }
  },
  "$id": "urn:devworks:architecture:1.0-draft.1:route-decision",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accessMode": {
      "$ref": "#/$defs/AccessMode"
    },
    "attemptId": {
      "$ref": "#/$defs/Id"
    },
    "attemptNumber": {
      "$ref": "#/$defs/Revision"
    },
    "binding": {
      "$ref": "#/$defs/NativeBinding"
    },
    "capabilityRevision": {
      "$ref": "#/$defs/Revision"
    },
    "capacityGrantId": {
      "$ref": "#/$defs/Id"
    },
    "catalogRevision": {
      "$ref": "#/$defs/Revision"
    },
    "connectionRevision": {
      "$ref": "#/$defs/Revision"
    },
    "credentialRevision": {
      "$ref": "#/$defs/Revision"
    },
    "pinRevision": {
      "anyOf": [
        {
          "$ref": "#/$defs/Revision"
        },
        {
          "type": "null"
        }
      ]
    },
    "policyRevision": {
      "$ref": "#/$defs/Revision"
    },
    "priceBasis": {
      "$ref": "#/$defs/PriceBasis"
    },
    "reason": {
      "$ref": "#/$defs/SelectionReason"
    },
    "requestId": {
      "$ref": "#/$defs/Id"
    }
  },
  "required": [
    "requestId",
    "attemptId",
    "attemptNumber",
    "binding",
    "accessMode",
    "connectionRevision",
    "credentialRevision",
    "capabilityRevision",
    "catalogRevision",
    "policyRevision",
    "reason",
    "capacityGrantId",
    "priceBasis"
  ],
  "title": "RouteDecision",
  "type": "object"
}
