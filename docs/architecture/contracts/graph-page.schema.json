{
  "$comment": "Architecture candidate only. Schema validation is followed by typed range, cross-field and authority validation. Not a public v1 SDK.",
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/Id"
        },
        "byteLength": {
          "$ref": "#/$defs/Counter"
        },
        "mediaType": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Digest"
        },
        "versionId": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "artifactId",
        "versionId",
        "sha256",
        "byteLength",
        "mediaType"
      ],
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "blockId": {
          "$ref": "#/$defs/Id"
        },
        "contentDigest": {
          "$ref": "#/$defs/Digest"
        },
        "locator": {
          "$ref": "#/$defs/Locator"
        },
        "source": {
          "$ref": "#/$defs/CitationSource"
        }
      },
      "required": [
        "source",
        "blockId",
        "contentDigest",
        "locator"
      ],
      "type": "object"
    },
    "CitationSource": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "connectionId": {
              "$ref": "#/$defs/Id"
            },
            "kind": {
              "const": "DatabaseSchema",
              "type": "string"
            },
            "schemaDigest": {
              "$ref": "#/$defs/Digest"
            },
            "snapshotId": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": [
            "kind",
            "connectionId",
            "snapshotId",
            "schemaDigest"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "extractionRevision": {
              "$ref": "#/$defs/Revision"
            },
            "kind": {
              "const": "Managed",
              "type": "string"
            },
            "version": {
              "$ref": "#/$defs/ArtifactRef"
            }
          },
          "required": [
            "kind",
            "version",
            "extractionRevision"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "Repository",
              "type": "string"
            },
            "snapshot": {
              "$ref": "#/$defs/RepositorySnapshot"
            },
            "sourceDigest": {
              "$ref": "#/$defs/Digest"
            },
            "unitKey": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": [
            "kind",
            "snapshot",
            "unitKey",
            "sourceDigest"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "entryId": {
              "$ref": "#/$defs/Id"
            },
            "kind": {
              "const": "Knowledge",
              "type": "string"
            },
            "revision": {
              "$ref": "#/$defs/Revision"
            }
          },
          "required": [
            "kind",
            "entryId",
            "revision"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "Convention",
              "type": "string"
            },
            "version": {
              "$ref": "#/$defs/ArtifactRef"
            }
          },
          "required": [
            "kind",
            "version"
          ],
          "type": "object"
        }
      ]
    },
    "Counter": {
      "description": "Canonical decimal 0..9223372036854775807. Typed range validation required.",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "type": "string"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "gaps": {
          "items": {
            "$ref": "#/$defs/Id"
          },
          "maxItems": 128,
          "type": "array"
        },
        "moreGaps": {
          "type": "boolean"
        },
        "state": {
          "$ref": "#/$defs/CoverageState"
        }
      },
      "required": [
        "state",
        "gaps",
        "moreGaps"
      ],
      "type": "object"
    },
    "CoverageState": {
      "enum": [
        "Complete",
        "Partial",
        "Unavailable"
      ],
      "type": "string"
    },
    "Digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "EdgeView": {
      "additionalProperties": false,
      "properties": {
        "edgeId": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "$ref": "#/$defs/Id"
        },
        "producingUnit": {
          "$ref": "#/$defs/Id"
        },
        "sourceId": {
          "$ref": "#/$defs/Id"
        },
        "targetId": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "edgeId",
        "sourceId",
        "targetId",
        "kind",
        "producingUnit"
      ],
      "type": "object"
    },
    "GitOid": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "$ref": "#/$defs/ObjectFormat"
        },
        "hex": {
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$",
          "type": "string"
        }
      },
      "required": [
        "format",
        "hex"
      ],
      "type": "object"
    },
    "GraphResult": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "Nodes",
              "type": "string"
            },
            "nodes": {
              "items": {
                "$ref": "#/$defs/NodeView"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "nodes"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "edges": {
              "items": {
                "$ref": "#/$defs/EdgeView"
              },
              "type": "array"
            },
            "kind": {
              "const": "Graph",
              "type": "string"
            },
            "nodes": {
              "items": {
                "$ref": "#/$defs/NodeView"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "nodes",
            "edges"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "citation": {
              "$ref": "#/$defs/Citation"
            },
            "kind": {
              "const": "Source",
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "citation",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "Schema",
              "type": "string"
            },
            "schema": {
              "$ref": "#/$defs/ArtifactRef"
            }
          },
          "required": [
            "kind",
            "schema"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "coverage": {
              "$ref": "#/$defs/Coverage"
            },
            "kind": {
              "const": "ScopeStatus",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "coverage"
          ],
          "type": "object"
        }
      ]
    },
    "Id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "LayerRef": {
      "additionalProperties": false,
      "properties": {
        "generationId": {
          "$ref": "#/$defs/Id"
        },
        "manifestDigest": {
          "$ref": "#/$defs/Digest"
        },
        "parentGenerationId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "generationId",
        "manifestDigest"
      ],
      "type": "object"
    },
    "Locator": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "SchemaObject",
              "type": "string"
            },
            "objectId": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": [
            "kind",
            "objectId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "firstLine": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "Text",
              "type": "string"
            },
            "lastLine": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "firstLine",
            "lastLine"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "Pdf",
              "type": "string"
            },
            "page": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "page"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "Docx",
              "type": "string"
            },
            "paragraph": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "part": {
              "$ref": "#/$defs/Id"
            },
            "tableCell": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Id"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "part",
            "paragraph"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "firstLine": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "Code",
              "type": "string"
            },
            "lastLine": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "snapshot": {
              "$ref": "#/$defs/RepositorySnapshot"
            },
            "unitKey": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": [
            "kind",
            "snapshot",
            "unitKey",
            "firstLine",
            "lastLine"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "entryId": {
              "$ref": "#/$defs/Id"
            },
            "kind": {
              "const": "Knowledge",
              "type": "string"
            },
            "revision": {
              "$ref": "#/$defs/Revision"
            }
          },
          "required": [
            "kind",
            "entryId",
            "revision"
          ],
          "type": "object"
        }
      ]
    },
    "NodeView": {
      "additionalProperties": false,
      "properties": {
        "citation": {
          "$ref": "#/$defs/Citation"
        },
        "kind": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "maxLength": 1024,
          "type": "string"
        },
        "nodeId": {
          "$ref": "#/$defs/Id"
        },
        "unitKey": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "nodeId",
        "unitKey",
        "kind",
        "name",
        "citation"
      ],
      "type": "object"
    },
    "ObjectFormat": {
      "enum": [
        "Sha1",
        "Sha256"
      ],
      "type": "string"
    },
    "Protocol": {
      "enum": [
        "1.0-draft.1"
      ],
      "type": "string"
    },
    "QueryCompletion": {
      "enum": [
        "Complete",
        "ResultLimit",
        "WorkLimit",
        "Deadline",
        "Cancelled"
      ],
      "type": "string"
    },
    "ReadStamp": {
      "additionalProperties": false,
      "properties": {
        "policyRevision": {
          "$ref": "#/$defs/Revision"
        },
        "restoreEpoch": {
          "$ref": "#/$defs/Counter"
        },
        "scopeRevision": {
          "$ref": "#/$defs/Revision"
        },
        "sequence": {
          "$ref": "#/$defs/Counter"
        },
        "storeId": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "storeId",
        "restoreEpoch",
        "sequence",
        "policyRevision",
        "scopeRevision"
      ],
      "type": "object"
    },
    "RepositorySnapshot": {
      "additionalProperties": false,
      "properties": {
        "base": {
          "$ref": "#/$defs/GitOid"
        },
        "captureDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "head": {
          "$ref": "#/$defs/GitOid"
        },
        "repositoryId": {
          "$ref": "#/$defs/Id"
        },
        "worktreeId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "repositoryId",
        "base",
        "head"
      ],
      "type": "object"
    },
    "RepositoryView": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "$ref": "#/$defs/LayerRef"
        },
        "branch": {
          "anyOf": [
            {
              "$ref": "#/$defs/LayerRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "snapshot": {
          "$ref": "#/$defs/RepositorySnapshot"
        },
        "sourceRevision": {
          "$ref": "#/$defs/Revision"
        },
        "viewId": {
          "$ref": "#/$defs/Id"
        },
        "worktree": {
          "anyOf": [
            {
              "$ref": "#/$defs/LayerRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "viewId",
        "snapshot",
        "sourceRevision",
        "baseline",
        "coverage"
      ],
      "type": "object"
    },
    "ResolvedViewSet": {
      "additionalProperties": false,
      "properties": {
        "expiresAtMs": {
          "$ref": "#/$defs/Counter"
        },
        "pinId": {
          "$ref": "#/$defs/Id"
        },
        "schemaViews": {
          "items": {
            "$ref": "#/$defs/SchemaView"
          },
          "maxItems": 256,
          "type": "array"
        },
        "stamp": {
          "$ref": "#/$defs/ReadStamp"
        },
        "views": {
          "items": {
            "$ref": "#/$defs/RepositoryView"
          },
          "maxItems": 256,
          "type": "array"
        }
      },
      "required": [
        "pinId",
        "stamp",
        "expiresAtMs",
        "views"
      ],
      "type": "object"
    },
    "Revision": {
      "description": "Positive signed-64-bit counter; typed upper-bound validation required.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "SchemaView": {
      "additionalProperties": false,
      "properties": {
        "accessRevision": {
          "$ref": "#/$defs/Revision"
        },
        "connectionId": {
          "$ref": "#/$defs/Id"
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "generationId": {
          "$ref": "#/$defs/Id"
        },
        "schemaDigest": {
          "$ref": "#/$defs/Digest"
        },
        "snapshotId": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "connectionId",
        "snapshotId",
        "generationId",
        "schemaDigest",
        "accessRevision",
        "coverage"
      ],
      "type": "object"
    }
  },
  "$id": "urn:devworks:architecture:1.0-draft.1:graph-page",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "completion": {
      "$ref": "#/$defs/QueryCompletion"
    },
    "nextCursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "protocol": {
      "$ref": "#/$defs/Protocol"
    },
    "queryId": {
      "$ref": "#/$defs/Id"
    },
    "result": {
      "$ref": "#/$defs/GraphResult"
    },
    "view": {
      "$ref": "#/$defs/ResolvedViewSet"
    }
  },
  "required": [
    "protocol",
    "queryId",
    "view",
    "completion",
    "result"
  ],
  "title": "GraphPage",
  "type": "object"
}
