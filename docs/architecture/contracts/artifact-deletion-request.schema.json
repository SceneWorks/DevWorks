{
  "$comment": "Architecture candidate only. Schema validation is followed by typed range, cross-field and authority validation. Not a public v1 SDK.",
  "$defs": {
    "ArtifactDeletion": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "artifactId": {
              "$ref": "#/$defs/Id"
            },
            "expectedReferenceRevision": {
              "$ref": "#/$defs/Revision"
            },
            "expectedRevision": {
              "$ref": "#/$defs/Revision"
            },
            "kind": {
              "const": "DeleteVersion",
              "type": "string"
            },
            "versionId": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": [
            "kind",
            "artifactId",
            "versionId",
            "expectedRevision",
            "expectedReferenceRevision"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "artifactId": {
              "$ref": "#/$defs/Id"
            },
            "expectedReferenceRevision": {
              "$ref": "#/$defs/Revision"
            },
            "expectedRevision": {
              "$ref": "#/$defs/Revision"
            },
            "expectedVersionsDigest": {
              "$ref": "#/$defs/Digest"
            },
            "kind": {
              "const": "DeleteArtifact",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "artifactId",
            "expectedRevision",
            "expectedReferenceRevision",
            "expectedVersionsDigest"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "artifactId": {
              "$ref": "#/$defs/Id"
            },
            "expectedReferenceRevision": {
              "$ref": "#/$defs/Revision"
            },
            "kind": {
              "const": "DetachProject",
              "type": "string"
            },
            "projectId": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": [
            "kind",
            "artifactId",
            "projectId",
            "expectedReferenceRevision"
          ],
          "type": "object"
        }
      ]
    },
    "Digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "Id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "Protocol": {
      "enum": [
        "1.0-draft.1"
      ],
      "type": "string"
    },
    "Revision": {
      "description": "Positive signed-64-bit counter; typed upper-bound validation required.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    }
  },
  "$id": "urn:devworks:architecture:1.0-draft.1:artifact-deletion-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "deletion": {
      "$ref": "#/$defs/ArtifactDeletion"
    },
    "protocol": {
      "$ref": "#/$defs/Protocol"
    },
    "requestKey": {
      "$ref": "#/$defs/Id"
    }
  },
  "required": [
    "protocol",
    "requestKey",
    "deletion"
  ],
  "title": "ArtifactDeletionRequest",
  "type": "object"
}
