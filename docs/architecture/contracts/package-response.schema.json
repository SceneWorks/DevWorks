{
  "$comment": "Architecture candidate only. Schema validation is followed by typed range, cross-field and authority validation. Not a public v1 SDK.",
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/Id"
        },
        "byteLength": {
          "$ref": "#/$defs/Counter"
        },
        "mediaType": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Digest"
        },
        "versionId": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "artifactId",
        "versionId",
        "sha256",
        "byteLength",
        "mediaType"
      ],
      "type": "object"
    },
    "Counter": {
      "description": "Canonical decimal 0..9223372036854775807. Typed range validation required.",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "type": "string"
    },
    "Digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "Id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "InvocationOutcome": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "artifacts": {
              "items": {
                "$ref": "#/$defs/ArtifactRef"
              },
              "maxItems": 128,
              "type": "array"
            },
            "kind": {
              "const": "Completed",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "artifacts"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "code": {
              "$ref": "#/$defs/Id"
            },
            "kind": {
              "const": "Failed",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "code"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "CancelledBeforeEffect",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "OutcomeUnknown",
              "type": "string"
            },
            "operationId": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": [
            "kind",
            "operationId"
          ],
          "type": "object"
        }
      ]
    },
    "QualifiedId": {
      "pattern": "^[a-z0-9_.-]{1,64}/[a-z0-9_.-]{1,64}$",
      "type": "string"
    },
    "Revision": {
      "description": "Positive signed-64-bit counter; typed upper-bound validation required.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "RpcError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "format": "int32",
          "type": "integer"
        },
        "data": {
          "$ref": "#/$defs/RpcErrorData"
        },
        "message": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "data"
      ],
      "type": "object"
    },
    "RpcErrorClass": {
      "enum": [
        "Busy",
        "PermissionDenied",
        "OutcomeUnknown",
        "ProtocolViolation",
        "Unavailable",
        "Conflict"
      ],
      "type": "string"
    },
    "RpcErrorData": {
      "additionalProperties": false,
      "properties": {
        "class": {
          "$ref": "#/$defs/RpcErrorClass"
        },
        "operationId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "class"
      ],
      "type": "object"
    },
    "RpcFailure": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/RpcError"
        },
        "id": {
          "$ref": "#/$defs/RpcFailureId"
        },
        "jsonrpc": {
          "$ref": "#/$defs/RpcVersion"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "error"
      ],
      "type": "object"
    },
    "RpcFailureId": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "RpcResult": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "contributionIds": {
              "items": {
                "$ref": "#/$defs/QualifiedId"
              },
              "maxItems": 256,
              "type": "array"
            },
            "features": {
              "items": {
                "$ref": "#/$defs/Id"
              },
              "maxItems": 64,
              "type": "array"
            },
            "kind": {
              "const": "Initialized",
              "type": "string"
            },
            "manifestDigest": {
              "$ref": "#/$defs/Digest"
            },
            "selected": {
              "$ref": "#/$defs/WireVersion"
            }
          },
          "required": [
            "kind",
            "selected",
            "manifestDigest",
            "contributionIds",
            "features"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "Activated",
              "type": "string"
            },
            "registryRevision": {
              "$ref": "#/$defs/Revision"
            },
            "stateGeneration": {
              "$ref": "#/$defs/Revision"
            }
          },
          "required": [
            "kind",
            "registryRevision",
            "stateGeneration"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "invocationId": {
              "$ref": "#/$defs/Id"
            },
            "kind": {
              "const": "InvocationFinished",
              "type": "string"
            },
            "outcome": {
              "$ref": "#/$defs/InvocationOutcome"
            }
          },
          "required": [
            "kind",
            "invocationId",
            "outcome"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "invocationId": {
              "$ref": "#/$defs/Id"
            },
            "kind": {
              "const": "CancelAcknowledged",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "invocationId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "ShutdownAcknowledged",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "artifact": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "kind": {
              "const": "BrokerCompleted",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "artifact"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "artifact": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ArtifactRef"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "const": "StateSnapshot",
              "type": "string"
            },
            "revision": {
              "$ref": "#/$defs/Revision"
            },
            "stateGeneration": {
              "$ref": "#/$defs/Revision"
            }
          },
          "required": [
            "kind",
            "stateGeneration",
            "revision"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "checkpoint": {
              "$ref": "#/$defs/Counter"
            },
            "kind": {
              "const": "EventCommitAccepted",
              "type": "string"
            },
            "operationIds": {
              "items": {
                "$ref": "#/$defs/Id"
              },
              "maxItems": 64,
              "type": "array"
            },
            "processingReceipt": {
              "$ref": "#/$defs/Id"
            },
            "stateRevision": {
              "$ref": "#/$defs/Revision"
            }
          },
          "required": [
            "kind",
            "processingReceipt",
            "checkpoint",
            "stateRevision",
            "operationIds"
          ],
          "type": "object"
        }
      ]
    },
    "RpcSuccess": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "jsonrpc": {
          "$ref": "#/$defs/RpcVersion"
        },
        "result": {
          "$ref": "#/$defs/RpcResult"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "type": "object"
    },
    "RpcVersion": {
      "enum": [
        "2.0"
      ],
      "type": "string"
    },
    "WireVersion": {
      "additionalProperties": false,
      "properties": {
        "major": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "minor": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "major",
        "minor"
      ],
      "type": "object"
    }
  },
  "$id": "urn:devworks:architecture:1.0-draft.1:package-response",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/RpcSuccess"
    },
    {
      "$ref": "#/$defs/RpcFailure"
    }
  ],
  "title": "RpcResponse"
}
