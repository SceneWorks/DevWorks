{
  "$comment": "Architecture candidate only. Schema validation is followed by typed range, cross-field and authority validation. Not a public v1 SDK.",
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/Id"
        },
        "byteLength": {
          "$ref": "#/$defs/Counter"
        },
        "mediaType": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Digest"
        },
        "versionId": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "artifactId",
        "versionId",
        "sha256",
        "byteLength",
        "mediaType"
      ],
      "type": "object"
    },
    "Counter": {
      "description": "Canonical decimal 0..9223372036854775807. Typed range validation required.",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "type": "string"
    },
    "DeliveryBarrier": {
      "additionalProperties": false,
      "properties": {
        "approvedScopeDigest": {
          "$ref": "#/$defs/Digest"
        },
        "deliveryId": {
          "$ref": "#/$defs/Id"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/DeliveryDependency"
          },
          "maxItems": 4096,
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/DeliveryKind"
        },
        "protocol": {
          "$ref": "#/$defs/Protocol"
        },
        "repositories": {
          "items": {
            "$ref": "#/$defs/RepositoryDelivery"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "rootId": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "protocol",
        "deliveryId",
        "rootId",
        "kind",
        "revision",
        "approvedScopeDigest",
        "repositories",
        "dependencies"
      ],
      "type": "object"
    },
    "DeliveryDependency": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "$ref": "#/$defs/Id"
        },
        "before": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "before",
        "after"
      ],
      "type": "object"
    },
    "DeliveryKind": {
      "enum": [
        "Feature",
        "StandaloneIssue"
      ],
      "type": "string"
    },
    "Digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "FeatureTaskIntegration": {
      "additionalProperties": false,
      "description": "The coordinator's evidence for publishing one repository of a feature task. Git provides\nboth revisions of the reviewed source and separately verifies the actual integration delta.",
      "properties": {
        "expectedTaskRevision": {
          "$ref": "#/$defs/Revision"
        },
        "focusedChecks": {
          "items": {
            "$ref": "#/$defs/Id"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array"
        },
        "predecessor": {
          "$ref": "#/$defs/GitOid"
        },
        "reviewId": {
          "$ref": "#/$defs/Id"
        },
        "reviewedBase": {
          "$ref": "#/$defs/GitOid"
        },
        "reviewedHead": {
          "$ref": "#/$defs/GitOid"
        },
        "taskHead": {
          "$ref": "#/$defs/GitOid"
        },
        "taskId": {
          "$ref": "#/$defs/Id"
        },
        "taskWorktreeId": {
          "$ref": "#/$defs/Id"
        },
        "verification": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "taskId",
        "expectedTaskRevision",
        "taskWorktreeId",
        "reviewId",
        "reviewedBase",
        "reviewedHead",
        "taskHead",
        "predecessor",
        "verification",
        "focusedChecks"
      ],
      "type": "object"
    },
    "GitCommand": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "expectedHead": {
              "$ref": "#/$defs/GitOid"
            },
            "kind": {
              "const": "Commit",
              "type": "string"
            },
            "message": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "worktreeId": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": [
            "kind",
            "worktreeId",
            "expectedHead",
            "message"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "expectedHead": {
              "$ref": "#/$defs/GitOid"
            },
            "expectedRemote": {
              "anyOf": [
                {
                  "$ref": "#/$defs/GitOid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "const": "Push",
              "type": "string"
            },
            "mode": {
              "$ref": "#/$defs/PushMode"
            },
            "remoteId": {
              "$ref": "#/$defs/Id"
            },
            "targetRef": {
              "type": "string"
            },
            "taskIntegration": {
              "$ref": "#/$defs/FeatureTaskIntegration",
              "x-since": 16
            },
            "worktreeId": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": [
            "kind",
            "worktreeId",
            "remoteId",
            "targetRef",
            "expectedHead",
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "baseRef": {
              "type": "string"
            },
            "coveredWorkIds": {
              "description": "Complete explicit task coverage of a grouped PR (revision 2). Absence covers its\nowning task only, preserving revision 1.",
              "items": {
                "$ref": "#/$defs/Id"
              },
              "maxItems": 256,
              "minItems": 1,
              "type": "array",
              "x-since": 2
            },
            "description": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "expectedHead": {
              "$ref": "#/$defs/GitOid"
            },
            "headRef": {
              "type": "string"
            },
            "kind": {
              "const": "OpenPullRequest",
              "type": "string"
            },
            "repositoryId": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": [
            "kind",
            "repositoryId",
            "headRef",
            "baseRef",
            "expectedHead",
            "description"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "barrier": {
              "$ref": "#/$defs/DeliveryBarrier",
              "x-since": 17
            },
            "deliveryId": {
              "$ref": "#/$defs/Id"
            },
            "expectedBarrierRevision": {
              "$ref": "#/$defs/Revision"
            },
            "expectedHead": {
              "$ref": "#/$defs/GitOid"
            },
            "kind": {
              "const": "Integrate",
              "type": "string"
            },
            "repositoryId": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": [
            "kind",
            "deliveryId",
            "expectedBarrierRevision",
            "repositoryId",
            "expectedHead"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "expectedHead": {
              "$ref": "#/$defs/GitOid"
            },
            "expectedOwnershipRevision": {
              "$ref": "#/$defs/Revision"
            },
            "kind": {
              "const": "Cleanup",
              "type": "string"
            },
            "worktreeId": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": [
            "kind",
            "worktreeId",
            "expectedOwnershipRevision",
            "expectedHead"
          ],
          "type": "object"
        }
      ]
    },
    "GitOid": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "$ref": "#/$defs/ObjectFormat"
        },
        "hex": {
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$",
          "type": "string"
        }
      },
      "required": [
        "format",
        "hex"
      ],
      "type": "object"
    },
    "Id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "MergeMethod": {
      "enum": [
        "MergeCommit",
        "Squash",
        "Rebase"
      ],
      "type": "string"
    },
    "ObjectFormat": {
      "enum": [
        "Sha1",
        "Sha256"
      ],
      "type": "string"
    },
    "Protocol": {
      "enum": [
        "1.0-draft.1"
      ],
      "type": "string"
    },
    "PushMode": {
      "enum": [
        "Normal",
        "ForceWithLease"
      ],
      "type": "string"
    },
    "RepositoryDelivery": {
      "additionalProperties": false,
      "properties": {
        "baseRef": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "expectedHead": {
          "$ref": "#/$defs/GitOid"
        },
        "mergeMethod": {
          "$ref": "#/$defs/MergeMethod"
        },
        "observedBase": {
          "$ref": "#/$defs/GitOid"
        },
        "policyRevision": {
          "$ref": "#/$defs/Revision"
        },
        "pullRequestId": {
          "$ref": "#/$defs/Id"
        },
        "repositoryId": {
          "$ref": "#/$defs/Id"
        },
        "reviewSource": {
          "$ref": "#/$defs/ReviewSource"
        }
      },
      "required": [
        "repositoryId",
        "pullRequestId",
        "baseRef",
        "expectedHead",
        "observedBase",
        "reviewSource",
        "mergeMethod",
        "evidence",
        "policyRevision"
      ],
      "type": "object"
    },
    "ReviewSource": {
      "enum": [
        "GitHubAutomated",
        "InAppIndependent"
      ],
      "type": "string"
    },
    "Revision": {
      "description": "Positive signed-64-bit counter; typed upper-bound validation required.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    }
  },
  "$id": "urn:devworks:architecture:1.0-draft.1:git-command-request.r17",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "command": {
      "$ref": "#/$defs/GitCommand"
    },
    "protocol": {
      "$ref": "#/$defs/Protocol"
    },
    "requestKey": {
      "$ref": "#/$defs/Id"
    },
    "schemaRevision": {
      "description": "Negotiated operation schema revision. Absent means 1. Only revisions the selected operation registers are admitted; any other is UnsupportedSchema before authority.",
      "maximum": 65535,
      "minimum": 17,
      "type": "integer"
    }
  },
  "required": [
    "protocol",
    "requestKey",
    "command",
    "schemaRevision"
  ],
  "title": "GitCommandRequest",
  "type": "object"
}
