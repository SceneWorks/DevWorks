{
  "$comment": "Architecture candidate only. Schema validation is followed by typed range, cross-field and authority validation. Not a public v1 SDK.",
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/Id"
        },
        "byteLength": {
          "$ref": "#/$defs/Counter"
        },
        "mediaType": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Digest"
        },
        "versionId": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "artifactId",
        "versionId",
        "sha256",
        "byteLength",
        "mediaType"
      ],
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "blockId": {
          "$ref": "#/$defs/Id"
        },
        "contentDigest": {
          "$ref": "#/$defs/Digest"
        },
        "locator": {
          "$ref": "#/$defs/Locator"
        },
        "source": {
          "$ref": "#/$defs/CitationSource"
        }
      },
      "required": [
        "source",
        "blockId",
        "contentDigest",
        "locator"
      ],
      "type": "object"
    },
    "CitationSource": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "connectionId": {
              "$ref": "#/$defs/Id"
            },
            "kind": {
              "const": "DatabaseSchema",
              "type": "string"
            },
            "schemaDigest": {
              "$ref": "#/$defs/Digest"
            },
            "snapshotId": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": [
            "kind",
            "connectionId",
            "snapshotId",
            "schemaDigest"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "extractionRevision": {
              "$ref": "#/$defs/Revision"
            },
            "kind": {
              "const": "Managed",
              "type": "string"
            },
            "version": {
              "$ref": "#/$defs/ArtifactRef"
            }
          },
          "required": [
            "kind",
            "version",
            "extractionRevision"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "Repository",
              "type": "string"
            },
            "snapshot": {
              "$ref": "#/$defs/RepositorySnapshot"
            },
            "sourceDigest": {
              "$ref": "#/$defs/Digest"
            },
            "unitKey": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": [
            "kind",
            "snapshot",
            "unitKey",
            "sourceDigest"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "entryId": {
              "$ref": "#/$defs/Id"
            },
            "kind": {
              "const": "Knowledge",
              "type": "string"
            },
            "revision": {
              "$ref": "#/$defs/Revision"
            }
          },
          "required": [
            "kind",
            "entryId",
            "revision"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "Convention",
              "type": "string"
            },
            "version": {
              "$ref": "#/$defs/ArtifactRef"
            }
          },
          "required": [
            "kind",
            "version"
          ],
          "type": "object"
        }
      ]
    },
    "Counter": {
      "description": "Canonical decimal 0..9223372036854775807. Typed range validation required.",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "type": "string"
    },
    "Digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "EmbeddingSpace": {
      "additionalProperties": false,
      "properties": {
        "dimensions": {
          "format": "uint32",
          "maximum": 65536,
          "minimum": 1,
          "type": "integer"
        },
        "metric": {
          "$ref": "#/$defs/Metric"
        },
        "modelDigest": {
          "$ref": "#/$defs/Digest"
        },
        "spaceId": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "spaceId",
        "modelDigest",
        "dimensions",
        "metric"
      ],
      "type": "object"
    },
    "GitOid": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "$ref": "#/$defs/ObjectFormat"
        },
        "hex": {
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$",
          "type": "string"
        }
      },
      "required": [
        "format",
        "hex"
      ],
      "type": "object"
    },
    "Id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "Locator": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "SchemaObject",
              "type": "string"
            },
            "objectId": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": [
            "kind",
            "objectId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "firstLine": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "Text",
              "type": "string"
            },
            "lastLine": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "firstLine",
            "lastLine"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "Pdf",
              "type": "string"
            },
            "page": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "page"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "Docx",
              "type": "string"
            },
            "paragraph": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "part": {
              "$ref": "#/$defs/Id"
            },
            "tableCell": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Id"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "part",
            "paragraph"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "firstLine": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "Code",
              "type": "string"
            },
            "lastLine": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "snapshot": {
              "$ref": "#/$defs/RepositorySnapshot"
            },
            "unitKey": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": [
            "kind",
            "snapshot",
            "unitKey",
            "firstLine",
            "lastLine"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "entryId": {
              "$ref": "#/$defs/Id"
            },
            "kind": {
              "const": "Knowledge",
              "type": "string"
            },
            "revision": {
              "$ref": "#/$defs/Revision"
            }
          },
          "required": [
            "kind",
            "entryId",
            "revision"
          ],
          "type": "object"
        }
      ]
    },
    "Metric": {
      "enum": [
        "L2",
        "Cosine"
      ],
      "type": "string"
    },
    "ObjectFormat": {
      "enum": [
        "Sha1",
        "Sha256"
      ],
      "type": "string"
    },
    "Passage": {
      "additionalProperties": false,
      "properties": {
        "chunkId": {
          "$ref": "#/$defs/Id"
        },
        "citation": {
          "$ref": "#/$defs/Citation"
        },
        "rank": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "text": {
          "maxLength": 65536,
          "type": "string"
        }
      },
      "required": [
        "chunkId",
        "citation",
        "text",
        "rank"
      ],
      "type": "object"
    },
    "Protocol": {
      "enum": [
        "1.0-draft.1"
      ],
      "type": "string"
    },
    "QueryCompletion": {
      "enum": [
        "Complete",
        "ResultLimit",
        "WorkLimit",
        "Deadline",
        "Cancelled"
      ],
      "type": "string"
    },
    "ReadStamp": {
      "additionalProperties": false,
      "properties": {
        "policyRevision": {
          "$ref": "#/$defs/Revision"
        },
        "restoreEpoch": {
          "$ref": "#/$defs/Counter"
        },
        "scopeRevision": {
          "$ref": "#/$defs/Revision"
        },
        "sequence": {
          "$ref": "#/$defs/Counter"
        },
        "storeId": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "storeId",
        "restoreEpoch",
        "sequence",
        "policyRevision",
        "scopeRevision"
      ],
      "type": "object"
    },
    "RepositorySnapshot": {
      "additionalProperties": false,
      "properties": {
        "base": {
          "$ref": "#/$defs/GitOid"
        },
        "captureDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "head": {
          "$ref": "#/$defs/GitOid"
        },
        "repositoryId": {
          "$ref": "#/$defs/Id"
        },
        "worktreeId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "repositoryId",
        "base",
        "head"
      ],
      "type": "object"
    },
    "RetrievalMode": {
      "enum": [
        "Lexical",
        "Vector",
        "Hybrid"
      ],
      "type": "string"
    },
    "Revision": {
      "description": "Positive signed-64-bit counter; typed upper-bound validation required.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    }
  },
  "$id": "urn:devworks:architecture:1.0-draft.1:retrieval-page",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "completion": {
      "$ref": "#/$defs/QueryCompletion"
    },
    "effectiveMode": {
      "$ref": "#/$defs/RetrievalMode"
    },
    "generationIds": {
      "items": {
        "$ref": "#/$defs/Id"
      },
      "type": "array"
    },
    "passages": {
      "items": {
        "$ref": "#/$defs/Passage"
      },
      "maxItems": 500,
      "type": "array"
    },
    "protocol": {
      "$ref": "#/$defs/Protocol"
    },
    "queryId": {
      "$ref": "#/$defs/Id"
    },
    "space": {
      "anyOf": [
        {
          "$ref": "#/$defs/EmbeddingSpace"
        },
        {
          "type": "null"
        }
      ]
    },
    "stamp": {
      "$ref": "#/$defs/ReadStamp"
    }
  },
  "required": [
    "protocol",
    "queryId",
    "stamp",
    "generationIds",
    "effectiveMode",
    "completion",
    "passages"
  ],
  "title": "RetrievalPage",
  "type": "object"
}
