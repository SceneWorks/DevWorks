{
  "$comment": "Architecture candidate only. Schema validation is followed by typed range, cross-field and authority validation. Not a public v1 SDK.",
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/Id"
        },
        "byteLength": {
          "$ref": "#/$defs/Counter"
        },
        "mediaType": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Digest"
        },
        "versionId": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "artifactId",
        "versionId",
        "sha256",
        "byteLength",
        "mediaType"
      ],
      "type": "object"
    },
    "Counter": {
      "description": "Canonical decimal 0..9223372036854775807. Typed range validation required.",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "type": "string"
    },
    "DeliveryDependency": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "$ref": "#/$defs/Id"
        },
        "before": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "before",
        "after"
      ],
      "type": "object"
    },
    "DeliveryKind": {
      "enum": [
        "Feature",
        "StandaloneIssue"
      ],
      "type": "string"
    },
    "Digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "GitOid": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "$ref": "#/$defs/ObjectFormat"
        },
        "hex": {
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$",
          "type": "string"
        }
      },
      "required": [
        "format",
        "hex"
      ],
      "type": "object"
    },
    "Id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "MergeMethod": {
      "enum": [
        "MergeCommit",
        "Squash",
        "Rebase"
      ],
      "type": "string"
    },
    "ObjectFormat": {
      "enum": [
        "Sha1",
        "Sha256"
      ],
      "type": "string"
    },
    "Protocol": {
      "enum": [
        "1.0-draft.1"
      ],
      "type": "string"
    },
    "RepositoryDelivery": {
      "additionalProperties": false,
      "properties": {
        "baseRef": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "expectedHead": {
          "$ref": "#/$defs/GitOid"
        },
        "mergeMethod": {
          "$ref": "#/$defs/MergeMethod"
        },
        "observedBase": {
          "$ref": "#/$defs/GitOid"
        },
        "policyRevision": {
          "$ref": "#/$defs/Revision"
        },
        "pullRequestId": {
          "$ref": "#/$defs/Id"
        },
        "repositoryId": {
          "$ref": "#/$defs/Id"
        },
        "reviewSource": {
          "$ref": "#/$defs/ReviewSource"
        }
      },
      "required": [
        "repositoryId",
        "pullRequestId",
        "baseRef",
        "expectedHead",
        "observedBase",
        "reviewSource",
        "mergeMethod",
        "evidence",
        "policyRevision"
      ],
      "type": "object"
    },
    "ReviewSource": {
      "enum": [
        "GitHubAutomated",
        "InAppIndependent"
      ],
      "type": "string"
    },
    "Revision": {
      "description": "Positive signed-64-bit counter; typed upper-bound validation required.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    }
  },
  "$id": "urn:devworks:architecture:1.0-draft.1:delivery-barrier",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approvedScopeDigest": {
      "$ref": "#/$defs/Digest"
    },
    "deliveryId": {
      "$ref": "#/$defs/Id"
    },
    "dependencies": {
      "items": {
        "$ref": "#/$defs/DeliveryDependency"
      },
      "maxItems": 4096,
      "type": "array"
    },
    "kind": {
      "$ref": "#/$defs/DeliveryKind"
    },
    "protocol": {
      "$ref": "#/$defs/Protocol"
    },
    "repositories": {
      "items": {
        "$ref": "#/$defs/RepositoryDelivery"
      },
      "maxItems": 256,
      "minItems": 1,
      "type": "array"
    },
    "revision": {
      "$ref": "#/$defs/Revision"
    },
    "rootId": {
      "$ref": "#/$defs/Id"
    }
  },
  "required": [
    "protocol",
    "deliveryId",
    "rootId",
    "kind",
    "revision",
    "approvedScopeDigest",
    "repositories",
    "dependencies"
  ],
  "title": "DeliveryBarrier",
  "type": "object"
}
