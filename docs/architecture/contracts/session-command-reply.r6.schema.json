{
  "$comment": "Architecture candidate only. Schema validation is followed by typed range, cross-field and authority validation. Not a public v1 SDK.",
  "$defs": {
    "Blocker": {
      "additionalProperties": false,
      "properties": {
        "cause": {
          "$ref": "#/$defs/Cause"
        },
        "holdId": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "subject": {
          "$ref": "#/$defs/Subject"
        }
      },
      "required": [
        "holdId",
        "revision",
        "subject",
        "cause"
      ],
      "type": "object"
    },
    "Blockers": {
      "additionalProperties": false,
      "properties": {
        "hasMore": {
          "type": "boolean"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/Blocker"
          },
          "maxItems": 100,
          "type": "array"
        }
      },
      "required": [
        "items",
        "hasMore"
      ],
      "type": "object"
    },
    "Cause": {
      "enum": [
        "HumanPause",
        "RestartContinue",
        "BudgetContinue",
        "Approval",
        "Dependency",
        "Reconciliation",
        "Credentials",
        "Capacity",
        "StorageUnavailable",
        "Policy"
      ],
      "type": "string"
    },
    "Counter": {
      "description": "Canonical decimal 0..9223372036854775807. Typed range validation required.",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "type": "string"
    },
    "Digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "DomainErrorCode": {
      "enum": [
        "NotFound",
        "RevisionConflict",
        "InvalidArgument",
        "PermissionDenied",
        "UnsupportedCapability",
        "UnsupportedTarget",
        "CredentialsRequired",
        "ApprovalRequired",
        "ContinueRequired",
        "DependencyBlocked",
        "CapacityWait",
        "BudgetHold",
        "SchemaMismatch",
        "SourceChanged",
        "ViewUnavailable",
        "CursorExpired",
        "LeaseLost",
        "Conflict",
        "Cancelled",
        "ExternalFailure",
        "OutcomeUnknown",
        "StorageUnavailable"
      ],
      "type": "string"
    },
    "Id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "Protocol": {
      "enum": [
        "1.0-draft.1"
      ],
      "type": "string"
    },
    "PurgedDecisionKind": {
      "enum": [
        "Applied",
        "Accepted",
        "NoChange",
        "Refused"
      ],
      "type": "string"
    },
    "PurgedReceiptOutcome": {
      "additionalProperties": false,
      "properties": {
        "acceptedAtMs": {
          "$ref": "#/$defs/Counter"
        },
        "commandId": {
          "$ref": "#/$defs/Id"
        },
        "committedSequence": {
          "$ref": "#/$defs/Revision"
        },
        "operationId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "originalDecision": {
          "$ref": "#/$defs/PurgedDecisionKind"
        },
        "originalFaultCode": {
          "anyOf": [
            {
              "$ref": "#/$defs/DomainErrorCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "purgeId": {
          "$ref": "#/$defs/Id"
        },
        "requestDigest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "commandId",
        "committedSequence",
        "acceptedAtMs",
        "requestDigest",
        "originalDecision",
        "purgeId"
      ],
      "type": "object"
    },
    "Receipt": {
      "additionalProperties": false,
      "properties": {
        "acceptedAtMs": {
          "$ref": "#/$defs/Counter"
        },
        "commandId": {
          "$ref": "#/$defs/Id"
        },
        "committedSequence": {
          "$ref": "#/$defs/Revision"
        },
        "decision": {
          "$ref": "#/$defs/SessionDecision"
        },
        "operationId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "requestDigest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "commandId",
        "committedSequence",
        "acceptedAtMs",
        "requestDigest",
        "decision"
      ],
      "type": "object"
    },
    "Rejection": {
      "enum": [
        "InvalidRequest",
        "UnsupportedSchema",
        "PermissionDenied",
        "InvalidTarget",
        "IdempotencyConflict",
        "StorageUnavailable"
      ],
      "type": "string"
    },
    "RetryAdvice": {
      "enum": [
        "Never",
        "SameCommand",
        "AfterBlockerClears",
        "ResolveReceipt",
        "ReconcileOperation",
        "RefreshAndNewRequest"
      ],
      "type": "string"
    },
    "Revision": {
      "description": "Positive signed-64-bit counter; typed upper-bound validation required.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "SessionDecision": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "entryId": {
              "$ref": "#/$defs/Id"
            },
            "kind": {
              "const": "MessageSaved",
              "type": "string"
            },
            "sequence": {
              "$ref": "#/$defs/Revision"
            },
            "sessionId": {
              "$ref": "#/$defs/Id"
            },
            "sessionRevision": {
              "$ref": "#/$defs/Revision"
            }
          },
          "required": [
            "kind",
            "sessionId",
            "sessionRevision",
            "entryId",
            "sequence"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "current": {
              "$ref": "#/$defs/Revision"
            },
            "expected": {
              "$ref": "#/$defs/Revision"
            },
            "kind": {
              "const": "RevisionConflict",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "expected",
            "current"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "blockers": {
              "$ref": "#/$defs/Blockers"
            },
            "kind": {
              "const": "Blocked",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "blockers"
          ],
          "type": "object"
        }
      ]
    },
    "Subject": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/Id"
            },
            "kind": {
              "const": "root",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/Id"
            },
            "kind": {
              "const": "assignment",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/Id"
            },
            "kind": {
              "const": "operation",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/Id"
            },
            "kind": {
              "const": "resource",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/Id"
            },
            "kind": {
              "const": "blocker",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "urn:devworks:architecture:1.0-draft.1:session-command-reply.r6",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "ReceiptPurged",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/PurgedReceiptOutcome"
        },
        "protocol": {
          "$ref": "#/$defs/Protocol"
        },
        "requestKey": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "kind",
        "protocol",
        "requestKey",
        "outcome"
      ],
      "type": "object",
      "x-since": 6
    },
    {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "Recorded",
          "type": "string"
        },
        "protocol": {
          "$ref": "#/$defs/Protocol"
        },
        "receipt": {
          "$ref": "#/$defs/Receipt"
        },
        "replayed": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "protocol",
        "receipt",
        "replayed"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/Rejection"
        },
        "correlationId": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "const": "Rejected",
          "type": "string"
        },
        "protocol": {
          "$ref": "#/$defs/Protocol"
        },
        "requestKey": {
          "$ref": "#/$defs/Id"
        },
        "retry": {
          "$ref": "#/$defs/RetryAdvice"
        }
      },
      "required": [
        "kind",
        "protocol",
        "requestKey",
        "code",
        "retry",
        "correlationId"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "correlationId": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "const": "CommandStatusUnknown",
          "type": "string"
        },
        "protocol": {
          "$ref": "#/$defs/Protocol"
        },
        "requestKey": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "kind",
        "protocol",
        "requestKey",
        "correlationId"
      ],
      "type": "object"
    }
  ],
  "title": "CommandReply"
}
