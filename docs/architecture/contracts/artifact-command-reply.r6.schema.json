{
  "$comment": "Architecture candidate only. Schema validation is followed by typed range, cross-field and authority validation. Not a public v1 SDK.",
  "$defs": {
    "ArtifactDecision": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "artifactId": {
              "$ref": "#/$defs/Id"
            },
            "kind": {
              "const": "VersionPublished",
              "type": "string"
            },
            "revision": {
              "$ref": "#/$defs/Revision"
            },
            "version": {
              "$ref": "#/$defs/ArtifactRef"
            }
          },
          "required": [
            "kind",
            "artifactId",
            "version",
            "revision"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "artifactId": {
              "$ref": "#/$defs/Id"
            },
            "kind": {
              "const": "ReferenceChanged",
              "type": "string"
            },
            "scopeRevision": {
              "$ref": "#/$defs/Revision"
            }
          },
          "required": [
            "kind",
            "artifactId",
            "scopeRevision"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "artifactId": {
              "$ref": "#/$defs/Id"
            },
            "kind": {
              "const": "VersionUnavailable",
              "type": "string"
            },
            "physicalDeletePending": {
              "type": "boolean"
            },
            "versionId": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": [
            "kind",
            "artifactId",
            "versionId",
            "physicalDeletePending"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "artifactId": {
              "$ref": "#/$defs/Id"
            },
            "kind": {
              "const": "SharedReferencesRemain",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "artifactId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "current": {
              "$ref": "#/$defs/Revision"
            },
            "expected": {
              "$ref": "#/$defs/Revision"
            },
            "kind": {
              "const": "RevisionConflict",
              "type": "string"
            },
            "revisionKind": {
              "$ref": "#/$defs/RevisionKind"
            }
          },
          "required": [
            "kind",
            "revisionKind",
            "expected",
            "current"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "artifactId": {
              "$ref": "#/$defs/Id"
            },
            "kind": {
              "const": "IndexDisabled",
              "type": "string"
            },
            "revision": {
              "$ref": "#/$defs/Revision"
            }
          },
          "required": [
            "kind",
            "artifactId",
            "revision"
          ],
          "type": "object"
        }
      ]
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/Id"
        },
        "byteLength": {
          "$ref": "#/$defs/Counter"
        },
        "mediaType": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Digest"
        },
        "versionId": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "artifactId",
        "versionId",
        "sha256",
        "byteLength",
        "mediaType"
      ],
      "type": "object"
    },
    "Counter": {
      "description": "Canonical decimal 0..9223372036854775807. Typed range validation required.",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "type": "string"
    },
    "Digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "DomainErrorCode": {
      "enum": [
        "NotFound",
        "RevisionConflict",
        "InvalidArgument",
        "PermissionDenied",
        "UnsupportedCapability",
        "UnsupportedTarget",
        "CredentialsRequired",
        "ApprovalRequired",
        "ContinueRequired",
        "DependencyBlocked",
        "CapacityWait",
        "BudgetHold",
        "SchemaMismatch",
        "SourceChanged",
        "ViewUnavailable",
        "CursorExpired",
        "LeaseLost",
        "Conflict",
        "Cancelled",
        "ExternalFailure",
        "OutcomeUnknown",
        "StorageUnavailable"
      ],
      "type": "string"
    },
    "Id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "Protocol": {
      "enum": [
        "1.0-draft.1"
      ],
      "type": "string"
    },
    "PurgedDecisionKind": {
      "enum": [
        "Applied",
        "Accepted",
        "NoChange",
        "Refused"
      ],
      "type": "string"
    },
    "PurgedReceiptOutcome": {
      "additionalProperties": false,
      "properties": {
        "acceptedAtMs": {
          "$ref": "#/$defs/Counter"
        },
        "commandId": {
          "$ref": "#/$defs/Id"
        },
        "committedSequence": {
          "$ref": "#/$defs/Revision"
        },
        "operationId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "originalDecision": {
          "$ref": "#/$defs/PurgedDecisionKind"
        },
        "originalFaultCode": {
          "anyOf": [
            {
              "$ref": "#/$defs/DomainErrorCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "purgeId": {
          "$ref": "#/$defs/Id"
        },
        "requestDigest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "commandId",
        "committedSequence",
        "acceptedAtMs",
        "requestDigest",
        "originalDecision",
        "purgeId"
      ],
      "type": "object"
    },
    "Receipt": {
      "additionalProperties": false,
      "properties": {
        "acceptedAtMs": {
          "$ref": "#/$defs/Counter"
        },
        "commandId": {
          "$ref": "#/$defs/Id"
        },
        "committedSequence": {
          "$ref": "#/$defs/Revision"
        },
        "decision": {
          "$ref": "#/$defs/ArtifactDecision"
        },
        "operationId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "requestDigest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "commandId",
        "committedSequence",
        "acceptedAtMs",
        "requestDigest",
        "decision"
      ],
      "type": "object"
    },
    "Rejection": {
      "enum": [
        "InvalidRequest",
        "UnsupportedSchema",
        "PermissionDenied",
        "InvalidTarget",
        "IdempotencyConflict",
        "StorageUnavailable"
      ],
      "type": "string"
    },
    "RetryAdvice": {
      "enum": [
        "Never",
        "SameCommand",
        "AfterBlockerClears",
        "ResolveReceipt",
        "ReconcileOperation",
        "RefreshAndNewRequest"
      ],
      "type": "string"
    },
    "Revision": {
      "description": "Positive signed-64-bit counter; typed upper-bound validation required.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "RevisionKind": {
      "enum": [
        "Work",
        "Control",
        "Blocker",
        "Operation",
        "Policy",
        "Scope",
        "Plan",
        "Authority"
      ],
      "type": "string"
    }
  },
  "$id": "urn:devworks:architecture:1.0-draft.1:artifact-command-reply.r6",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "ReceiptPurged",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/PurgedReceiptOutcome"
        },
        "protocol": {
          "$ref": "#/$defs/Protocol"
        },
        "requestKey": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "kind",
        "protocol",
        "requestKey",
        "outcome"
      ],
      "type": "object",
      "x-since": 6
    },
    {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "Recorded",
          "type": "string"
        },
        "protocol": {
          "$ref": "#/$defs/Protocol"
        },
        "receipt": {
          "$ref": "#/$defs/Receipt"
        },
        "replayed": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "protocol",
        "receipt",
        "replayed"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/Rejection"
        },
        "correlationId": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "const": "Rejected",
          "type": "string"
        },
        "protocol": {
          "$ref": "#/$defs/Protocol"
        },
        "requestKey": {
          "$ref": "#/$defs/Id"
        },
        "retry": {
          "$ref": "#/$defs/RetryAdvice"
        }
      },
      "required": [
        "kind",
        "protocol",
        "requestKey",
        "code",
        "retry",
        "correlationId"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "correlationId": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "const": "CommandStatusUnknown",
          "type": "string"
        },
        "protocol": {
          "$ref": "#/$defs/Protocol"
        },
        "requestKey": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "kind",
        "protocol",
        "requestKey",
        "correlationId"
      ],
      "type": "object"
    }
  ],
  "title": "CommandReply"
}
