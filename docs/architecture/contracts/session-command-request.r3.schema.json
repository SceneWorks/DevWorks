{
  "$comment": "Architecture candidate only. Schema validation is followed by typed range, cross-field and authority validation. Not a public v1 SDK.",
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/Id"
        },
        "byteLength": {
          "$ref": "#/$defs/Counter"
        },
        "mediaType": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Digest"
        },
        "versionId": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "artifactId",
        "versionId",
        "sha256",
        "byteLength",
        "mediaType"
      ],
      "type": "object"
    },
    "ConversationRoutePreference": {
      "additionalProperties": false,
      "properties": {
        "effort": {
          "$ref": "#/$defs/EffortName"
        },
        "intent": {
          "$ref": "#/$defs/RouteIntent"
        }
      },
      "required": [
        "intent",
        "effort"
      ],
      "type": "object"
    },
    "Counter": {
      "description": "Canonical decimal 0..9223372036854775807. Typed range validation required.",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "type": "string"
    },
    "Digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "EffortName": {
      "enum": [
        "Default",
        "Minimal",
        "Low",
        "Medium",
        "High",
        "XHigh",
        "Max"
      ],
      "type": "string"
    },
    "Id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "Protocol": {
      "enum": [
        "1.0-draft.1"
      ],
      "type": "string"
    },
    "Revision": {
      "description": "Positive signed-64-bit counter; typed upper-bound validation required.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "RouteIntent": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "Tier",
              "type": "string"
            },
            "tier": {
              "$ref": "#/$defs/TierName"
            }
          },
          "required": [
            "kind",
            "tier"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "Model",
              "type": "string"
            },
            "modelId": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": [
            "kind",
            "modelId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "OpenRouterAuto",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "DevWorksAuto",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object",
          "x-since": 3
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "OpenRouterAutoBeta",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object",
          "x-since": 3
        }
      ]
    },
    "TierName": {
      "enum": [
        "Max",
        "High",
        "Mid",
        "Low"
      ],
      "type": "string"
    },
    "UserContent": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "Text",
              "type": "string"
            },
            "text": {
              "maxLength": 65536,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "artifact": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "kind": {
              "const": "Attachment",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "artifact"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "urn:devworks:architecture:1.0-draft.1:session-command-request.r3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content": {
      "items": {
        "$ref": "#/$defs/UserContent"
      },
      "maxItems": 128,
      "minItems": 1,
      "type": "array"
    },
    "expectedSessionRevision": {
      "$ref": "#/$defs/Revision"
    },
    "protocol": {
      "$ref": "#/$defs/Protocol"
    },
    "replyRoute": {
      "$ref": "#/$defs/ConversationRoutePreference",
      "x-since": 3
    },
    "requestKey": {
      "$ref": "#/$defs/Id"
    },
    "schemaRevision": {
      "description": "Negotiated operation schema revision. Absent means 1. Only revisions the selected operation registers are admitted; any other is UnsupportedSchema before authority.",
      "maximum": 65535,
      "minimum": 3,
      "type": "integer"
    },
    "sessionId": {
      "$ref": "#/$defs/Id"
    }
  },
  "required": [
    "protocol",
    "requestKey",
    "sessionId",
    "expectedSessionRevision",
    "content",
    "schemaRevision"
  ],
  "title": "SessionCommandRequest",
  "type": "object"
}
