{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "devworks://schemas/convention-manifest/1",
  "title": "DevWorks portable convention manifest version 1",
  "description": "One authored Markdown convention and its binary resources. No source author is trusted as a native principal. UTF-8 source bytes and configured artifact/resource budgets are checked before atomic publication. Parent slugs resolve only within the explicitly authorized destination scope. Import creates a new convention; duplicate sibling slugs are conflicts.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "devworks-convention"
    },
    "version": {
      "const": 1
    },
    "slug": {
      "type": "string",
      "minLength": 0,
      "maxLength": 200
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
    },
    "parentPath": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 0,
        "maxLength": 200
      },
      "maxItems": 3
    },
    "sortOrder": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647
    },
    "lifecycle": {
      "enum": [
        "Active",
        "Retired"
      ]
    },
    "applicability": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[^\\u0000]*$"
      },
      "maxItems": 128,
      "uniqueItems": true
    },
    "markdown": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byteLength": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "text": {
          "type": "string",
          "x-maxUtf8Bytes": 16777215,
          "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
        }
      },
      "required": [
        "sha256",
        "byteLength",
        "text"
      ]
    },
    "rawContent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byteLength": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "text": {
          "type": "string",
          "x-maxUtf8Bytes": 16777215
        }
      },
      "required": [
        "sha256",
        "byteLength",
        "text"
      ]
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\u0000]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[^\\u0000]*$"
          },
          "mediaType": {
            "type": "string",
            "minLength": 0,
            "maxLength": 200,
            "pattern": "^[^\\u0000]*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "byteLength": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "lifecycle": {
            "enum": [
              "Active",
              "Retired"
            ]
          },
          "base64": {
            "type": "string",
            "contentEncoding": "base64",
            "x-configuredMaximum": "conventions.resourceMaxBytes and storage.artifactMaxFileBytes"
          }
        },
        "required": [
          "key",
          "name",
          "mediaType",
          "sha256",
          "byteLength",
          "lifecycle",
          "base64"
        ]
      }
    }
  },
  "required": [
    "format",
    "version",
    "slug",
    "title",
    "parentPath",
    "sortOrder",
    "lifecycle",
    "applicability",
    "markdown",
    "resources"
  ]
}
