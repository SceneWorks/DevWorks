  "quirks": [
    "UTC start inclusive, end exclusive; omitted end uses current UTC and omitted start is end minus30days",
    "Invalid start>=end or unsupported interval raises a typed native invalid-input fault",
    "Interval trimmed/case-insensitive; blank/auto selects day<=45days,week<=180days,month otherwise; weeks start Monday",
    "Empty buckets are explicit zero metric points; unavailable native billing/cache metrics remain separate nullable observations",
    "Breakdowns omit nonpositive values; descending value then ordinal label; blank keys become (unknown)",
    "Assistant unique chats use per-user chat identity; completed/failed/cancelled status matching is case-insensitive",
    "MCP average duration rounds like .NET Math.Round (ties to even); blank MCP usernames excluded from uniqueUsers",
    "Filters union visible LLM usage, assistant runs and MCP invocation data for the selected time range",
    "Consumer forwards original EventId to recorder; native attempt/event dedupe must be proven by its owner"
  ],
  "nativeAdaptation": [
    "All authorized scope/project/work/session/job filters intersect, never grant caller authority",
