{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repositoryId",
    "commit",
    "captureDigest",
    "sourceMode",
    "files",
    "runtime"
  ],
  "properties": {
    "repositoryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "commit": {
      "type": "string",
      "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "captureDigest": {
      "type": [
        "null",
        "string"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceMode": {
      "const": "Repository"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit",
          "language",
          "sha256",
          "text"
        ],
        "properties": {
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "language": {
            "enum": [
              "swift",
              "swift-context"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frontend",
        "indexStore",
        "target",
        "sdk",
        "resourceDirectory",
        "frameworks",
        "platformLibraries",
        "plugins",
        "testingPlugins",
        "inProcessServer",
        "platformPlugins",
        "platformServer",
        "sdkSettings",
        "files",
        "directories"
      ],
      "properties": {
        "frontend": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "program",
            "identity"
          ],
          "properties": {
            "program": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "identity": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "indexStore": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "program",
            "identity"
          ],
          "properties": {
            "program": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "identity": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "target": {
          "type": "string",
          "pattern": "^arm64-apple-macosx[0-9.]+$",
          "maxLength": 48
        },
        "sdk": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "resourceDirectory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "frameworks": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "platformLibraries": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "plugins": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "testingPlugins": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "inProcessServer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "platformPlugins": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "platformServer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sdkSettings": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "files": {
          "type": "array",
          "minItems": 5,
          "maxItems": 387,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "program",
              "identity"
            ],
            "properties": {
              "program": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "identity": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "directories": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "identity"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "identity": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
