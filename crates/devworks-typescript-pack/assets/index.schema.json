{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startLine",
        "startColumn",
        "endLine",
        "endColumn",
        "startByte",
        "endByte"
      ],
      "properties": {
        "startLine": {
          "type": "integer",
          "minimum": 1
        },
        "startColumn": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "endColumn": {
          "type": "integer",
          "minimum": 1
        },
        "startByte": {
          "type": "integer",
          "minimum": 0
        },
        "endByte": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "qualifiedName",
        "span",
        "parent",
        "properties"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "qualifiedName": {
          "type": "string",
          "minLength": 1
        },
        "span": {
          "$ref": "#/$defs/span"
        },
        "parent": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "properties": {
          "type": "object"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source",
        "target",
        "resolution",
        "confidence",
        "properties"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "integer",
          "minimum": 0
        },
        "target": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "local"
              ],
              "properties": {
                "local": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "symbol"
              ],
              "properties": {
                "symbol": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "node"
              ],
              "properties": {
                "node": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "unit",
                    "kind",
                    "qualified_name"
                  ],
                  "properties": {
                    "unit": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "type": "string",
                      "minLength": 1
                    },
                    "qualified_name": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          ]
        },
        "resolution": {
          "enum": [
            "resolved",
            "inferred",
            "unresolved"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "properties": {
          "type": "object"
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "units"
  ],
  "properties": {
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unitKey",
          "nodes",
          "edges"
        ],
        "properties": {
          "unitKey": {
            "type": "string",
            "minLength": 1
          },
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/node"
            },
            "maxItems": 50000
          },
          "edges": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/edge"
            },
            "maxItems": 100000
          }
        }
      },
      "maxItems": 4096
    }
  }
}
